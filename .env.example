# 复制为 .env 后按需填写（.env 已在 .gitignore 中）
# 也可在 IDE 运行配置 / 服务器环境中设置同名变量

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/test?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT（主服务与 Sandbox 建议一致，至少 32 字符）
JWT_SECRET=ChangeMe-DevOnly-Set-JWT-SECRET-At-Least-32-Chars!!

# 密码 pepper（可选）
APP_SECURITY_PEPPER=

# Sandbox
SANDBOX_URL=http://127.0.0.1:8080/api/sandbox
SANDBOX_AUTH_KEY=replace-with-a-random-secret-at-least-32-characters
CODESANDBOX_TYPE=remote

# MinIO（头像与图像题题图）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mayue-oj
MINIO_PUBLIC_URL=

# YOLOv8 自动标注服务
VISION_AI_ENABLED=true
VISION_AI_BASE_URL=http://127.0.0.1:8090
VISION_MODEL_GENERAL=yolov8n.pt
VISION_MODEL_HELMET=models/hard-hat-best.pt

# 本地 ComfyUI 题图生成（服务运行在 Windows 主机）
IMAGE_GENERATION_ENABLED=true
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 必须与 ComfyUI/models/checkpoints 中的文件名完全一致
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# 多个已安装模型用英文逗号分隔；列表之外的 checkpoint 不会出现在页面
COMFYUI_ALLOWED_CHECKPOINTS=v1-5-pruned-emaonly.safetensors
# 生产环境默认使用北京地域 DashScope 原生生图接口；也可填工作空间专属地址。
# DASHSCOPE_IMAGE_BASE_URL=https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
COMFYUI_TIMEOUT_SECONDS=180

# 百炼 AI（不用保持 BAILIAN_ENABLED=false）
BAILIAN_ENABLED=false
DASHSCOPE_API_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=

# 邮件（不用可留空）
MAIL_USERNAME=
MAIL_PASSWORD=
