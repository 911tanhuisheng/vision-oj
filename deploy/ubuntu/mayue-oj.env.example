# 复制到服务器 /etc/mayue-oj/app.env 后填写真实值。
# 该文件只应保存在服务器，权限应为 600，禁止提交 Git。

SERVER_PORT=8888
SPRING_PROFILES_ACTIVE=prod

MYSQL_URL=jdbc:mysql://127.0.0.1:3306/tan?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USER=tan
MYSQL_PASSWORD=replace_with_your_mysql_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
# 已有用户的站点必须保持原值；变更此值会使旧密码验证失败。
APP_SECURITY_PEPPER=

MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace_with_your_minio_access_key
MINIO_SECRET_KEY=replace_with_your_minio_secret_key
MINIO_BUCKET=mayue-oj
MINIO_PUBLIC_URL=

CODESANDBOX_TYPE=remote
SANDBOX_URL=http://127.0.0.1:8080/api/sandbox
SANDBOX_AUTH_HEADER=auth
SANDBOX_AUTH_KEY=replace_with_a_random_sandbox_secret_at_least_32_characters

# 4GB 服务器默认关闭重资源本地服务；需要时才改为 true 并启动相应服务。
VISION_AI_ENABLED=false
VISION_AI_BASE_URL=http://127.0.0.1:8090
IMAGE_GENERATION_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
BAILIAN_ENABLED=false
DASHSCOPE_API_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=
