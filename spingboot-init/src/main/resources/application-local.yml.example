# 将此模板复制到 spingboot-init/application-local.yml（模块根目录，不在 src/main/resources）。
# 该文件被 Git 忽略，也不会进入 JAR。dev 配置会自动读取本文件，
# 前提是 IDE/Maven 的工作目录为 spingboot-init/。

spring:
  datasource:
    password: your_local_mysql_password
  mail:
    username: your_email@example.com
    password: your_mail_app_password

jwt:
  secret: replace-with-a-random-local-secret-at-least-32-characters

minio:
  access-key: minioadmin
  secret-key: minioadmin

codesandbox:
  auth-key: replace-with-a-random-sandbox-secret-at-least-32-characters

bailian:
  enabled: false
  api-key:

ai:
  personal-key-encryption-key:
