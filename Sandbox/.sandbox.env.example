# Ubuntu Sandbox 本机配置：复制为 .sandbox.env 后修改。
# 该文件已被 Git 忽略，不要把真实密钥提交到仓库。
SERVER_PORT=8080
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SANDBOX_AUTH_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=ChangeMe-Replace-With-A-Random-Secret-At-Least-32-Chars
SANDBOX_PYTHON_IMAGE=mayue-oj-python-vision:1.0
SANDBOX_TMP_DIR=/tmp/mayue-oj-sandbox
